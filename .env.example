# Diese Datei nach .env kopieren und Werte anpassen
DB_NAME=kataster
DB_USER=kataster
DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-random-secret
ADMIN_PASSWORD=change-me-admin-password
WEHRNAME=Musterwehr

# Startposition der Karte (Gerätehaus) - optional; der Installer trägt diese
# Werte automatisch ein. Ohne sie startet die Karte mit der Deutschland-Übersicht.
WEHR_LAT=
WEHR_LNG=
# Umkreis in km, damit die Karte beim Start einen passenden Ausschnitt zeigt
WEHR_VIEW_RADIUS=20
