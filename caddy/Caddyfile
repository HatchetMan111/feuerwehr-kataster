{
	# Interne Zertifikate: funktionieren auch ohne öffentliche Domain,
	# müssen einmalig auf den Geräten der Gruppenführer als vertrauenswürdig
	# hinterlegt werden (siehe README, Abschnitt "TLS-Zertifikat").
	auto_https disable_redirects
}

:443 {
	# Bewusst ohne festen Hostnamen/IP: Browser und curl senden bei einer
	# reinen IP-Adresse kein SNI mit. Ein an einen bestimmten Namen
	# gebundenes Zertifikat führte dabei zu einem TLS-internal-error.
	# Dieser Catch-All-Block bedient jede Verbindung auf Port 443 mit
	# genau einem selbstsignierten Zertifikat, unabhängig von der IP.
	tls internal

	handle_path /api/* {
		reverse_proxy backend:3000
	}

	handle_path /tiles/* {
		# overv/openstreetmap-tile-server liefert Kacheln unter /tile/{z}/{x}/{y}.png
		rewrite * /tile{path}
		reverse_proxy tileserver:80
	}

	handle_path /admin/* {
		reverse_proxy admin-web:80
	}

	handle {
		reverse_proxy einsatz-pwa:80
	}
}
